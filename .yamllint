---
extends: default

rules:
  line-length:
    max: 120
  # cairn emits ownership entries as `{ path: ..., owner: ... }` with inner
  # spaces; raw profiles are byte-exact tool output and must not be reflowed.
  braces:
    max-spaces-inside: 1
  comments:
    min-spaces-from-content: 1
  # raw profiles are machine-generated; reviewed profiles carry long
  # provenance comment blocks — don't fight either.
  comments-indentation: disable
  document-start:
    present: true

ignore: |
  site/
  out/
